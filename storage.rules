rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Provider ID documents & portfolio assets
    match /providers/{providerId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == providerId || request.auth.token.email == 'orsasson140701@gmail.com');
    }
    // User profile images
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Default fallback
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'orsasson140701@gmail.com';
    }
  }
}
