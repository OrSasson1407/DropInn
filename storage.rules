rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.email == 'orsasson140701@gmail.com' || request.auth.token.email == 'admin@dropinn.com');
    }

    // Provider ID documents & portfolio assets
    match /providers/{providerId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == providerId || isAdmin());
    }

    // User profile images: owner or admin only (not every signed-in user)
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Default fallback: deny by default, admin only
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}