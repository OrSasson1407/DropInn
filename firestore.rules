rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /providers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if true; 
    }
  }
}
