{
  "name": "dropin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "firebase": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^30.0.1",
    "vite": "^5.1.4",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run",
    "test:unit": "vitest run src/__tests__/unit",
    "test:component": "vitest run src/__tests__/component",
    "test:rules": "vitest run src/__tests__/rules",
    "test:a11y": "vitest run src/__tests__/a11y",
    "test:concurrency": "vitest run src/__tests__/concurrency",
    "test:edge_cases": "vitest run src/__tests__/edge_cases",
    "test:integration": "vitest run src/__tests__/integration",
    "test:performance": "vitest run src/__tests__/performance",
    "test:regression": "vitest run src/__tests__/regression",
    "test:visual": "vitest run src/__tests__/visual",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "emulators:exec": "firebase emulators:exec \"npm test\""
  }
}
